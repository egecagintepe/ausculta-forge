# AuscultaForge ESP32-S3 Experimental Bench Configuration Defaults
# Target: ESP32-S3 (WROOM-1 / N16R8)

CONFIG_IDF_TARGET="esp32s3"

# Flash & PSRAM settings for N16R8
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# FreeRTOS 1000 Hz tick rate for precise 10 ms scheduling
CONFIG_FREERTOS_HZ=1000

# TinyUSB Stack Configuration
CONFIG_TINYUSB=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048

# USB Serial/JTAG - Disable to allow Native USB OTG exclusive control
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
