# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg

# Python virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE and Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Generated audio and multimedia outputs
*.wav
*.mp3
*.flac
*.ogg
demo_raw.wav
demo_filtered.wav

# Datasets and raw data (never commit raw/processed medical datasets to git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.dat
*.hea
*.mat
*.tar.gz
*.zip
*.7z

# Temporary experiment outputs and logs
experiments/output/*
experiments/runs/*
experiments/logs/*
!experiments/output/.gitkeep
!experiments/runs/.gitkeep
!experiments/logs/.gitkeep
*.log

# Frontend dependencies, builds, and caches
software/frontend/node_modules/
software/frontend/dist/
software/frontend/.vite/
software/frontend/.env.local
software/frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Session recording outputs
experiments/sessions/*
!experiments/sessions/.gitkeep
